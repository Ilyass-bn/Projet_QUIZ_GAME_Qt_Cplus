        </property>
        <property name="styleSheet">
         <string notr="true">
QComboBox#comboBox {
    border: 2px solid #B0B0B0;
    border-radius: 8px;
    padding: 5px 10px;
	background-color: rgb(80, 80, 80);
    color:white;
    font-size: 15px;
    font-weight: bold;
}


QComboBox#comboBox:hover {
    border-color: gray; 
}


QComboBox#comboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left-width: 0px; 
}


QComboBox#comboBox::down-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/arrow-down-16.png);
    width: 12px;
    height: 12px;
}


QComboBox#comboBox QAbstractItemView {
    border: 2px solid rgb(152, 152, 152) ; 
    border-radius: 8px;
    	background-color: rgb(80, 80, 80);
    padding: 5px;
    outline: 0px;
}


QComboBox#comboBox QAbstractItemView::item:selected {
    background-color: gray;
    color: black;        
}


QComboBox#comboBox QAbstractItemView::item {
    height: 30px;
    padding-left: 10px;
    color: white;           
    	background-color: rgb(80, 80, 80);
    border-radius: 4px;
}</string>
